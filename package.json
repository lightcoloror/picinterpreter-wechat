{
  "name": "cboard-wechat-poc",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightcoloror/picinterpreter-wechat.git"
  },
  "description": "PicInterpreter CBoard WeChat communication PoC",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "None",
    "framework": "React"
  },
  "scripts": {
    "generate:boards": "node ./scripts/generate-cboard-default-boards.mjs",
    "check:boards": "node ./scripts/check-generated-boards.mjs",
    "check:symbol-licenses": "node ./scripts/check-symbol-licenses.mjs",
    "check:symbol-licenses:formal": "node ./scripts/check-symbol-licenses.mjs --formal-release",
    "generate:symbol-license-inventory": "node ./scripts/check-symbol-licenses.mjs --write-inventory",
    "prebuild:weapp": "npm run check:boards && npm run check:symbol-licenses",
    "build:weapp": "node ./node_modules/@tarojs/cli/bin/taro build --type weapp",
    "analyze:weapp": "set WEAPP_BUNDLE_ANALYZE=1&& npm run build:weapp&& node ./node_modules/webpack-bundle-analyzer/lib/bin/analyzer.js ./.bundle-analysis/weapp-stats.json ./dist --mode json --report ./.bundle-analysis/weapp-report.json --no-open",
    "postbuild:weapp": "node ./scripts/check-weapp-output.mjs",
    "predev:weapp": "node ./scripts/check-generated-boards.mjs",
    "dev:weapp": "node ./node_modules/@tarojs/cli/bin/taro build --type weapp --watch",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "posttest": "npm run test:quality-gate",
    "test:quality-gate": "node ./scripts/weapp-output-quality.test.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js src --ext .ts,.tsx",
    "check:boundary": "node ./scripts/check-boundary.mjs",
    "check:release-readiness": "node ./scripts/release-readiness.mjs",
    "create:release-evidence": "node ./scripts/create-release-evidence.mjs",
    "check:local-release": "npm run typecheck && npm run lint && npm test && npm run check:boundary && npm run build:weapp && npm run create:release-evidence",
    "test:e2e:weapp": "node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:restore-storage": "node ./scripts/weapp-skill-smoke.mjs --restore-storage-recovery",
    "test:e2e:weapp:ordering": "set WEAPP_E2E_ORDERING_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:session": "set WEAPP_E2E_SESSION_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:feedback": "set WEAPP_E2E_FEEDBACK_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:board-visibility": "set WEAPP_E2E_BOARD_VISIBILITY_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:library-placement": "set WEAPP_E2E_LIBRARY_PLACEMENT_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:accessibility": "set WEAPP_E2E_ACCESSIBILITY_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:board-management": "set WEAPP_E2E_BOARD_MANAGEMENT_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:personal-card-copy": "set WEAPP_E2E_PERSONAL_CARD_COPY_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:adult-care-defaults": "set WEAPP_E2E_ADULT_CARE_DEFAULTS_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:offline": "set WEAPP_E2E_OFFLINE_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:storage-failure": "set WEAPP_E2E_STORAGE_FAILURE_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:history-review": "set WEAPP_E2E_HISTORY_REVIEW_ONLY=1&& node ./scripts/weapp-skill-smoke.mjs",
    "test:e2e:weapp:ocr": "node ./scripts/weapp-account-sync-skill-smoke.mjs --ocr",
    "test:e2e:weapp:account": "node ./scripts/weapp-account-sync-skill-smoke.mjs",
    "test:e2e:weapp:legacy": "node ./scripts/weapp-smoke.mjs",
    "test:e2e:weapp:legacy:enable-service": "node ./scripts/weapp-smoke.mjs --enable-ide-service"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "base64-js": "1.5.1",
    "fflate": "0.8.3",
    "jszip": "3.10.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.2.0",
    "@tarojs/plugin-generator": "4.2.0",
    "@tarojs/taro-loader": "4.2.0",
    "@tarojs/webpack5-runner": "4.2.0",
    "@types/minimatch": "^5",
    "@types/node": "^22",
    "@types/react": "^18.0.0",
    "babel-preset-taro": "4.2.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.2.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "miniprogram-automator": "0.12.1",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "vitest": "4.1.10",
    "webpack": "5.91.0",
    "webpack-bundle-analyzer": "5.3.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
